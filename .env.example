# Sao chép thành .env.local khi dev. Trên cPanel khai báo trong "Setup Node.js App" → Environment variables.
# KHÔNG commit file .env thật.

# --- Đọc lúc runtime (server) ---
# URL công khai của website, không có dấu / ở cuối. Dùng cho canonical, sitemap, Open Graph.
# Trên Vercel có thể bỏ trống (tự lấy VERCEL_PROJECT_PRODUCTION_URL).
SITE_URL=https://example.com
# Base URL backend blog/nội dung. Có thể bỏ trống khi USE_MOCK_API=true (mặc định http://localhost:4010).
API_BASE_URL=https://api.example.com
# Token gửi kèm header Authorization: Bearer <token> (bỏ trống nếu backend không yêu cầu).
API_TOKEN=
# Secret cho POST /api/revalidate (header x-revalidate-secret). Tối thiểu 32 ký tự.
# Tạo bằng: openssl rand -hex 32
REVALIDATE_SECRET=
# true = dùng mock server trong mocks/ (chỉ cho dev/test).
USE_MOCK_API=false
# true = dữ liệu mẫu đóng gói sẵn, không gọi backend (bản preview/demo, vd. Vercel). Tự bật SITE_NOINDEX.
MOCK_API_INLINE=false
# true = chặn bot index toàn site (robots.txt Disallow: /, meta noindex) — dùng cho staging/preview.
SITE_NOINDEX=false
# Timeout gọi backend (ms), mặc định 8000. Thường để trống.
BACKEND_TIMEOUT_MS=

# --- Đọc lúc BUILD (đổi phải build lại) ---
# true = tắt tối ưu ảnh (dùng khi sharp không chạy được trên hosting).
IMAGE_UNOPTIMIZED=false
# Host ảnh bổ sung ngoài host của API_BASE_URL, phân tách bằng dấu phẩy. Ví dụ: https://cdn.example.com
IMAGE_HOSTS=
# true = log URL đầy đủ của fetch (kiểm tra cache HIT/MISS).
LOG_FETCHES=false
