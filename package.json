{
  "name": "lapbee-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:content": "vitest run tests/content",
    "prebuild": "npm run test:content",
    "mock": "node mocks/server.mjs",
    "build:mock": "node scripts/with-mock.mjs npm run build",
    "dev:mock": "node scripts/with-mock.mjs npm run dev",
    "icons": "node scripts/generate-icons.mjs",
    "og-image": "node scripts/og-image.mjs"
  },
  "dependencies": {
    "lucide-react": "1.75.0",
    "marked": "18.1.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
